# Copy to .env and adjust if needed. Do not commit .env.
# Empty values fall back to dev defaults from compose.yaml; production
# (compose.prod.yaml) refuses to start until the secrets below are set.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nimuairy
CLOUDFLARED_TOKEN=

# At least 32 chars. Required in production.
JWT_SECRET=
