# Copy to .env and adjust if needed. Do not commit .env.
# These are local-development-only defaults, not production secrets.

POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=nimuairy

# Dev placeholder, must be at least 32 chars. Replace with a real secret
# outside of version control for any non-local deployment.
JWT_SECRET=nimuairy-jwt-secret-key-change-in-production-min-32-chars
