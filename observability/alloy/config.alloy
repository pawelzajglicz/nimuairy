// Grafana Alloy — log shipper for Docker containers.
// Ships the stdout/stderr of the containers labelled observability.logs=true to Loki with
// low-cardinality labels (container, logstream, compose_service, compose_project, app). It reads
// the Docker API through docker-socket-proxy and never mounts the Docker socket itself.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  // Through the socket proxy (observability/compose.yaml), which allows only the calls these two
  // components make. tcp://, not http://: for http(s) hosts Alloy v1.20 sets the client timeout to
  // refresh_interval, which cuts every followed log stream (grafana/alloy#7290, fixed in v1.21).
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "5s"

  // Collection is an explicit allowlist: only containers with this label are listed, so no
  // other container is ever inspected or tailed. The Docker API applies the filter.
  filter {
    name   = "label"
    values = ["observability.logs=true"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "logstream"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_observability_app"]
    target_label  = "app"
  }
}

loki.source.docker "containers" {
  host          = "tcp://docker-socket-proxy:2375"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.write.local.receiver]
  relabel_rules = discovery.relabel.containers.rules
  refresh_interval = "5s"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    stack = "observability",
  }
}
